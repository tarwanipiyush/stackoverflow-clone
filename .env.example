APP_NAME="Stack Overflow Clone"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL (XAMPP defaults: user root, empty password). Create/keep a database named "stackoverflow" in phpMyAdmin.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stackoverflow
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Emails (new-reply / best-answer notifications) are written to storage/logs/laravel.log.
# To really send mail, switch to smtp and fill in a Mailtrap/Gmail account.
MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="admin@stackoverflow-clone.test"
MAIL_FROM_NAME="${APP_NAME}"
